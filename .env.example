# Copy this file to `.env` in the same folder as `package.json`, then set your real URL.

# Local API direct connection:
# - Android emulator on same PC: EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# - Physical phone on same Wi-Fi: EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# - Direct local API testing also needs EXPO_PUBLIC_INTERNAL_API_SECRET to match apiconnect/local-api/.env.
#
# Production Worker connection:
# - Use your Cloudflare Worker/custom-domain URL.
# - Use EXPO_PUBLIC_API_KEY, not EXPO_PUBLIC_INTERNAL_API_SECRET, for field builds.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_KEY=
EXPO_PUBLIC_INTERNAL_API_SECRET=
EXPO_PUBLIC_ALLOW_CLEARTEXT=false
EXPO_PUBLIC_DEMO_USERNAME=
EXPO_PUBLIC_DEMO_PASSWORD=

# Local Worker (`npm run dev` in apiconnect/cloudflare-worker):
# - Android emulator on same PC: EXPO_PUBLIC_API_URL=http://10.0.2.2:8787
# - Physical phone on same Wi-Fi: EXPO_PUBLIC_API_URL=http://192.168.x.x:8787
# - iOS simulator: EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# - For local HTTP only: EXPO_PUBLIC_ALLOW_CLEARTEXT=true or APP_ENV=development
